# Copy to .env (git-ignored) and fill in. Names only: never commit real values.
# Everything is optional: with nothing set ECHOS runs fully offline with dry-run mail (outbox rows only).

# --- URGENT alert e-mail. Real sending needs config alerts.send_real: true (or scripts/start.sh --real --yes); the default is a dry run.
ECHOS_CAREGIVER_EMAIL=
ECHOS_CLINICIAN_EMAIL=
ECHOS_ESCALATION_EMAIL=      # second contact when nobody acknowledges in time
ECHOS_SMTP_HOST=
ECHOS_SMTP_PORT=587
ECHOS_SMTP_USER=
ECHOS_SMTP_PASSWORD=

# --- "I have seen this" link in alert e-mails (both needed, otherwise the mail has no link). Secret: any random string of 16+ characters.
ECHOS_LINK_SECRET=
ECHOS_PUBLIC_URL=      # where the API is reachable from the recipient, e.g. https://echos.example.org

# --- Runtime switches (usually set by scripts/run_api.sh flags, not by hand)
# ECHOS_DRY_RUN=1          # the SMTP mailer refuses to start
# ECHOS_DB=data/echos.db   # database used by the API / runtime
