# Copy to .env (git-ignored) and fill in. Names only: never commit real values.
# Everything is optional: with nothing set ECHOS runs fully offline (template reports, dry-run mail, no PubMed).

# --- Report agent LLM (Google Gemini, google-genai). Model names live in config.yaml (llm.model, llm.fallback_model).
ECHOS_LLM_API_KEY=

# --- PubMed (NCBI E-utilities) for MONITOR / URGENT daily reports. Email identifies the tool to NCBI; the key only raises the rate limit.
ECHOS_NCBI_EMAIL=
NCBI_API_KEY=

# --- Alert e-mail. Real sending needs config alerts.send_real: true; the default is a dry run (outbox rows only, SMTP never used).
ECHOS_CAREGIVER_EMAIL=
ECHOS_CLINICIAN_EMAIL=
ECHOS_SMTP_HOST=
ECHOS_SMTP_PORT=587
ECHOS_SMTP_USER=
ECHOS_SMTP_PASSWORD=

# --- Runtime switches (usually set by scripts/run_api.sh flags or the evaluation scripts, not by hand)
# ECHOS_REPORT_LLM=off     # no Gemini client may start
# ECHOS_PUBMED=off         # no PubMed request may be made
# ECHOS_DRY_RUN=1          # the SMTP mailer refuses to start
# ECHOS_DB=data/echos.db   # database used by the API / runtime
