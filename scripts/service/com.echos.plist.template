<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd job (macOS): restarts ECHOS (API + watchdog + runtime) if the whole thing dies, which is what the watchdog cannot do for itself.
     NOT installed by any script. Copy to ~/Library/LaunchAgents/com.echos.plist, replace __ECHOS_DIR__, then: launchctl load ~/Library/LaunchAgents/com.echos.plist
     Secrets (ECHOS_LLM_API_KEY, tokens, addresses) stay in .env / the environment, never in this file. See scripts/service/README.md. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.echos</string>
  <key>WorkingDirectory</key><string>__ECHOS_DIR__</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>__ECHOS_DIR__/scripts/run_api.sh</string><string>--mode</string><string>live</string><string>--dry</string><string>--no-llm</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__ECHOS_DIR__/data/echos_service.log</string>
  <key>StandardErrorPath</key><string>__ECHOS_DIR__/data/echos_service.log</string>
</dict></plist>
